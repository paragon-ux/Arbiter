{
  "name": "arbiter",
  "version": "2.1.1",
  "private": true,
  "description": "Local-first multi-agent task orchestration engine and worktree supervisor with Waymark continuity.",
  "type": "module",
  "main": "./dist/src/index.js",
  "bin": {
    "arbiter": "./dist/src/cli/cli.js",
    "arbiter-mcp": "./dist/src/mcp/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paragon-ux/Arbiter.git"
  },
  "bugs": {
    "url": "https://github.com/paragon-ux/Arbiter/issues"
  },
  "homepage": "https://github.com/paragon-ux/Arbiter#readme",
  "license": "MIT",
  "keywords": [
    "multi-agent",
    "orchestration",
    "git-worktrees",
    "mcp",
    "model-context-protocol",
    "waymark",
    "continuity",
    "sqlite"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "node scripts/build-native.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage \"dist/test/**/*.test.js\"",
    "public-check": "node scripts/public-check.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "check:claims": "node scripts/claims-check.mjs",
    "check:hygiene": "node scripts/claims-hygiene.mjs",
    "check:checklist": "node scripts/check-checklist.mjs",
    "check:version": "node scripts/bump-version.mjs --check",
    "bump:version": "node scripts/bump-version.mjs",
    "verify": "npm run build && node --test \"dist/test/**/*.test.js\" && node scripts/public-check.mjs && node scripts/benchmark.mjs && npm run check:claims && npm run check:hygiene && npm run check:checklist && npm run check:version"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
